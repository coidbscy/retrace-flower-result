# Vercel Marketplace의 Upstash Redis를 연결하면 아래 두 값은 Vercel이 자동으로 넣어줍니다.
# 로컬에서 테스트하려면 Vercel 대시보드 > Storage > 해당 Redis > .env.local 받기로 값을 채우세요.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Anthropic 콘솔(console.anthropic.com)에서 발급받은 API 키.
# 절대 클라이언트 코드에 넣지 말고, 서버 환경변수로만 사용하세요.
ANTHROPIC_API_KEY=

# "mock"으로 설정하면 Claude API를 호출하지 않고, 화면 테스트용 가짜 분석을 돌려줍니다.
# 비워두면(기본값) 실제 Claude API를 호출합니다. 실제 서비스 전에는 꼭 지워주세요.
ANALYSIS_MODE=
